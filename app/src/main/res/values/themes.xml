<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EnvelopeMoney" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/mountain_primary</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.EnvelopeMoney.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.EnvelopeMoney.ReceiptPreview" parent="Theme.EnvelopeMoney.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.EnvelopeMoney.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.EnvelopeMoney.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Parent must exist in Material 1.6.1 (OutlinedButton.IconOnly was added in a later MC release). -->
    <style name="Widget.MountainMoney.TransactionReceiptIconButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="iconPadding">0dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorControlNormal</item>
    </style>
</resources>