<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.example.envelopemoney.receipt.ReceiptZoomImageView
        android:id="@+id/receiptZoomImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/receipt_preview_title" />

    <LinearLayout
        android:id="@+id/receiptPreviewTopChrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/receiptPreviewToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnReceiptPreviewClose"
                    android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                    android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/content_desc_close_receipt_preview"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back_white_24"
                    android:tint="@android:color/white" />

                <!-- Candidate check header: transaction context the user double-checks against. -->
                <LinearLayout
                    android:id="@+id/candidateInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvCandidateTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCandidateDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnReceiptChooseDifferent"
                android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_marginStart="@dimen/receipt_preview_toolbar_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/receipt_choose_different"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_swap_white_24" />

            <ImageButton
                android:id="@+id/btnReceiptSaveRotation"
                android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_marginStart="@dimen/receipt_preview_toolbar_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/receipt_preview_save_rotation"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_save_white_24" />

            <ImageButton
                android:id="@+id/btnReceiptRotateLeft"
                android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_marginStart="@dimen/receipt_preview_toolbar_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/receipt_preview_rotate_left"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rotate_left_white_24" />

            <ImageButton
                android:id="@+id/btnReceiptRotateRight"
                android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_marginStart="@dimen/receipt_preview_toolbar_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/receipt_preview_rotate_right"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_rotate_right_white_24" />

            <ImageButton
                android:id="@+id/btnReceiptPreviewFullscreen"
                android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
                android:layout_marginStart="@dimen/receipt_preview_toolbar_icon_gap"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/content_desc_receipt_preview_fullscreen"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_fullscreen_white_24"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvReceiptPreviewGesturesHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="@string/receipt_preview_gestures_hint"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Candidate check navigation: arrows, counter, and the deliberate attach action. -->
    <LinearLayout
        android:id="@+id/candidateBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnCandidatePrevious"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_receipt_candidate_previous"
            android:src="@drawable/ic_back_white_24"
            android:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCandidateCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCandidateSelect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/receipt_candidate_select"
                android:textColor="@color/white"
                app:backgroundTint="@color/mountain_primary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCandidateNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_receipt_candidate_next"
            android:rotation="180"
            android:src="@drawable/ic_back_white_24"
            android:tint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReceiptPreviewErrorFull"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="24dp"
        android:textColor="@android:color/white"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnReceiptPreviewExitFullscreen"
        android:layout_width="@dimen/receipt_preview_toolbar_icon_size"
        android:layout_height="@dimen/receipt_preview_toolbar_icon_size"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="#CC000000"
        android:contentDescription="@string/content_desc_receipt_preview_exit_fullscreen"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_fullscreen_exit_white_24"
        android:visibility="gone" />
</FrameLayout>
