<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptCamera"
                style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/content_desc_receipt_camera_scan_icon"
                android:text=""
                app:icon="@drawable/ic_menu_camera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptGallery"
                style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/content_desc_receipt_pick_gallery_icon"
                android:text=""
                app:icon="@drawable/ic_menu_gallery" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptPreview"
                style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/content_desc_receipt_preview_icon"
                android:enabled="false"
                android:text=""
                app:icon="@drawable/ic_receipt_photo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptRemove"
                style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/content_desc_receipt_remove_icon"
                android:enabled="false"
                android:text=""
                app:icon="@drawable/ic_receipt_delete" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.example.envelopemoney.ui.BoundedNestedScrollView
        android:id="@+id/scrollTransactionDialogBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReceiptOcrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutRowPond"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_pond_label" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/spinnerEditEnvelope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="0"
                    android:importantForAutofill="no"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Date" />

            <EditText
                android:id="@+id/etEditTransactionDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:hint="Select Date" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Amount" />

            <FrameLayout
                android:id="@+id/frameAmountSlot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etEditTransactionAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount"
                    android:inputType="numberDecimal|numberSigned" />

                <EditText
                    android:id="@+id/etSplitPurchaseTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/split_purchase_total_hint"
                    android:inputType="numberDecimal|numberSigned"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Comment" />

            <EditText
                android:id="@+id/etEditTransactionComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Comment"
                android:inputType="text" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabTransactionType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:tabGravity="fill"
                app:tabMode="fixed" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabTransactionTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabGravity="fill"
                app:tabMode="fixed" />

            <LinearLayout
                android:id="@+id/panelSpending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecurringFrequencyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recurring Frequency"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutRecurringFrequencyOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnRecurringWeekly"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Weekly"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringBiWeekly"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Bi-weekly"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringMonthly"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Monthly"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecurringDaysLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recurring Days"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutRecurringWeekdayButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btnRecurringDayMon"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="M"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringDayTue"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="T"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringDayWed"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="W"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringDayThu"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Th"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringDayFri"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="F"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRecurringDaySat"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/recurring_option_unselected_ripple"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="S"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvRecurringDaysValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/recurring_option_unselected_ripple"
                android:clickable="true"
                android:contentDescription="@string/content_desc_recurring_day_picker"
                android:drawablePadding="8dp"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="yes"
                android:minHeight="40dp"
                android:padding="10dp"
                android:text="Select days"
                android:textColor="?android:attr/textColorPrimary"
                android:visibility="gone"
                app:drawableEndCompat="@drawable/ic_calendar_bills_setup"
                app:drawableTint="?attr/colorControlNormal" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelTransfer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutTransferBucketsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTransferSummaryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRANSFER SUMMARY"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransferAllocatedSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Allocated: $0.00"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTransferSpentHereSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Spent in this pond: $0.00"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTransferRemainingSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Left to allocate: $0.00"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvTransferStepHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Fixed step: $0.50"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvTransferValidationMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@android:color/holo_red_dark"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutTransferBucketsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddTransferBucket"
                    style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/content_desc_add_transfer_bucket"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textSize="24sp"
                    app:icon="@null" />
            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelSplitPurchase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/split_purchase_summary_title"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSplitAllocatedSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/split_purchase_allocated_default"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvSplitValidationMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@android:color/holo_red_dark"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutSplitBucketsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSplitBucket"
                    style="@style/Widget.MountainMoney.TransactionReceiptIconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/content_desc_add_split_bucket"
                    android:text="+"
                    android:textAllCaps="false"
                    android:textSize="24sp"
                    app:icon="@null" />
            </LinearLayout>

        </LinearLayout>
    </com.example.envelopemoney.ui.BoundedNestedScrollView>
</LinearLayout>
