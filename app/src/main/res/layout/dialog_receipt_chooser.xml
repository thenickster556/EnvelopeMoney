<?xml version="1.0" encoding="utf-8"?>
<!-- Bounded so a long candidate list scrolls inside the dialog, like the transaction dialogs. -->
<com.example.envelopemoney.ui.BoundedNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/receiptChooserRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />
</com.example.envelopemoney.ui.BoundedNestedScrollView>
