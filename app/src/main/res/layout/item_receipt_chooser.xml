<?xml version="1.0" encoding="utf-8"?>
<!-- One candidate picture in the receipt recovery chooser. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/receiptChooserThumbnail"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="@string/receipt_chooser_title"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_receipt_photo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/receiptChooserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/receiptChooserDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <!-- OCR content-match evidence; "Reading receipt…" until the scan lands. -->
        <TextView
            android:id="@+id/receiptChooserBadge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/receipt_chooser_badge_reading"
            android:textColor="?android:attr/textColorTertiary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
