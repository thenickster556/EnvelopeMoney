<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/receiptToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/receipt_scan_title"
        app:titleTextColor="?attr/colorOnPrimary" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/receipt_mode_hint"
        android:textSize="12sp"
        android:gravity="center" />

    <RadioGroup
        android:id="@+id/rgCaptureMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <RadioButton
            android:id="@+id/rbModeAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receipt_mode_auto" />

        <RadioButton
            android:id="@+id/rbModeReceipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receipt_mode_receipt" />

        <RadioButton
            android:id="@+id/rbModeRestaurant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receipt_mode_restaurant" />

        <RadioButton
            android:id="@+id/rbModeGas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/receipt_mode_gas" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="6dp"
        android:text="@string/receipt_gallery_save_hint"
        android:textSize="11sp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShutter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/receipt_capture_button" />

</LinearLayout>
